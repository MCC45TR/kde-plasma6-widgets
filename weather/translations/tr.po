msgstr "📅 Bugün PAZAR, 10°C Bulutlu"

#: contents/ui/config/ConfigNotifications.qml:225
msgid ""
"MON: 6°C 🌪️ Storm\n"
"TUE: 15°C 🌧️ Rainy\n"
"WED: 20°C ☀️ Sunny\n"
"THU: 17°C ⛅ Partly Cloudy"
msgstr ""
"PZT: 6°C 🌪️ Fırtına\n"
"SAL: 15°C 🌧️ Yağmurlu\n"
"ÇAR: 20°C ☀️ Güneşli\n"
"PER: 17°C ⛅ Parçalı Bulutlu"

#: contents/ui/config/ConfigNotifications.qml:234
msgid "Storm"
msgstr "Fırtına"

#: contents/ui/config/ConfigNotifications.qml:238
msgid ""
"Thunderstorm expected between 14:00 - 18:00\n"
"Temperature: 22°C → 18°C\n"
"Stay indoors and avoid open areas."
msgstr ""
"14:00 - 18:00 arasında fırtına bekleniyor\n"
"Sıcaklık: 22°C → 18°C\n"
"İçeride kalın ve açık alanlardan kaçının."

#: contents/ui/config/ConfigNotifications.qml:249
msgid ""
"Rain expected between 10:00 - 16:00\n"
"Temperature: 15°C\n"
"Chance of Rain: 80%\n"
"Precipitation: 4.5 mm\n"
"Don't forget your umbrella!"
msgstr ""
"10:00 - 16:00 arasında yağmur bekleniyor\n"
"Sıcaklık: 15°C\n"
"Yağmur Olasılığı: % 80\n"
"Yağış: 4.5 mm\n"
"Şemsiyenizi almayı unutmayın!"

#: contents/ui/config/ConfigNotifications.qml:260
msgid ""
"Snowfall expected between 06:00 - 12:00\n"
"Temperature: -3°C → -5°C\n"
"Roads may be slippery."
msgstr ""
"06:00 - 12:00 arasında kar yağışı bekleniyor\n"
"Sıcaklık: -3°C → -5°C\n"
"Yollar kaygan olabilir."

#: contents/ui/config/ConfigNotifications.qml:271
msgid ""
"Dense fog expected between 05:00 - 09:00\n"
"Visibility: Low\n"
"Temperature: 8°C\n"
"Drive carefully."
msgstr ""
"05:00 - 09:00 arasında yoğun sis bekleniyor\n"
"Görüş: Düşük\n"
"Sıcaklık: 8°C\n"
"Dikkatli sürün."

#: contents/ui/config/ConfigNotifications.qml:282
msgid ""
"Wind speed: 65 km/h\n"
"Secure loose objects."
msgstr ""
"Rüzgar hızı: 65 km/h\n"
"Gevşek nesneleri sabitleyin."

#: contents/ui/config/ConfigNotifications.qml:293
msgid ""
"Current UV Index: 8\n"
"Use sunscreen and wear protective clothing."
msgstr ""
"Mevcut UV İndeksi: 8\n"
"Güneş kremi kullanın ve koruyucu giysiler giyin."

#: contents/ui/config/ConfigNotifications.qml:300
msgid "High Temp"
msgstr "Yüksek Sıcaklık"

#: contents/ui/config/ConfigNotifications.qml:304
msgid ""
"Current temperature: 35°C\n"
"Stay hydrated."
msgstr ""
"Mevcut sıcaklık: 35°C\n"
"Bol sıvı tüketin."

#: contents/ui/config/ConfigNotifications.qml:311
msgid "Low Temp"
msgstr "Düşük Sıcaklık"

#: contents/ui/config/ConfigNotifications.qml:315
msgid "Current temperature: -5°C"
msgstr "Mevcut sıcaklık: -5°C"

#: contents/ui/config/ConfigNotifications.qml:323
